# =============================================================================
# Slipstream API — example environment configuration
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# All values below are placeholders / safe local-dev defaults only.
# =============================================================================

# --- HTTP server ---
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed CORS origins (the Next.js web app).
CORS_ORIGINS=http://localhost:3001

# --- Database (Prisma / PostgreSQL) ---
# Local-dev default matches docker-compose.yml. Local-only credentials.
DATABASE_URL=postgresql://slipstream:slipstream_local_dev@localhost:5432/slipstream?schema=public

# --- Redis (BullMQ queue) ---
# If REDIS_HOST is empty/unset the queue runs in a no-op/in-memory-safe mode
# and the analysis worker is NOT registered (see src/queue).
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# --- slipstream-core engine ---
# Path or name of the `slipstream` CLI binary (built from the sibling
# slipstream-core repo). Defaults to `slipstream` on PATH.
SLIPSTREAM_BIN=slipstream
# Milliseconds to allow a single core invocation before timing out.
SLIPSTREAM_TIMEOUT_MS=60000

# --- GitHub App / webhooks ---
# HMAC secret configured on the GitHub webhook. Use a strong random value.
GITHUB_WEBHOOK_SECRET=replace-with-a-strong-random-secret
# GitHub App credentials. The webhook→analysis→check-run flow is wired against
# the GitHubAppClient interface (mock by default); a real client reads these.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=

# --- Security hardening ---
# Rate limiting: default ON outside the test env (100 req / 60s per IP).
# Set RATE_LIMIT_ENABLED=true/false to force, or to tune:
# RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_LIMIT=100

# --- Stellar (interfaces + mocks only; real network calls out of scope) ---
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
HORIZON_URL=https://horizon-testnet.stellar.org
